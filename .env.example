APP_NAME="Motorcycle Parts Store Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motorcycle_parts_store_management_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email (password reset). Free option: a Gmail account with an "App password"
# (Google Account > Security > 2-Step Verification > App passwords).
# Put the Gmail address in MAIL_USERNAME and MAIL_FROM_ADDRESS, the 16-character app password in MAIL_PASSWORD.
# Other values for MAIL_MAILER: phpmail (PHP mail() function, needs sendmail on the server) or log (writes to storage/logs).
# Test it with:  php artisan mail:test you@example.com
# Messages from a free address often land in the spam/junk folder.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Default accounts created by `php artisan db:seed` (defaults live in config/store.php if a line is missing).
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@oneprompt.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_INSTRUCTOR_EMAIL=instructor@oneprompt.test
SEED_INSTRUCTOR_PASSWORD=Instructor@12345
SEED_INVENTORY_EMAIL=inventory@oneprompt.test
SEED_INVENTORY_PASSWORD=Inventory@12345
SEED_SALES_EMAIL=sales@oneprompt.test
SEED_SALES_PASSWORD=Sales@12345

# ---------------------------------------------------------------------------
# Machine learning (Python). Leave ML_PYTHON empty to auto-detect .venv, python3 or python.
# Windows example: ML_PYTHON=C:/Python312/python.exe
# ---------------------------------------------------------------------------
ML_PYTHON=
ML_TIMEOUT=600
